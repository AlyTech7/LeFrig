# Copia a scripts/ops/.env.ops (gitignored) y carga con:
#   set -a && source scripts/ops/.env.ops && set +a   # bash
#   Get-Content scripts/ops/.env.ops | ForEach-Object { ... }  # PowerShell manual

# API pública (Heroku, Fly, Render, etc.)
API_PUBLIC_URL=https://api.lefrig.com

# Webhook Clerk (opcional; por defecto API_PUBLIC_URL + /auth/clerk/webhook)
# WEBHOOK_URL=https://api.lefrig.com/auth/clerk/webhook

# Clerk — nunca commitear valores reales
CLERK_SECRET_KEY=sk_live_xxxxxxxx

# Portal Svix / webhooks Clerk (scripts enable-svix-endpoint, rotate-svix-secret, etc.)
CLERK_SVIX_APP_ID=app_xxxxxxxx
CLERK_SVIX_ENDPOINT_ID=ep_xxxxxxxx

# Solo scripts legacy DigitalOcean App Platform (uno o varios separados por coma)
# DO_APP_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# DO_APP_IDS=prod-id,staging-id
