# Database
DATABASE_URL="postgresql://lefrig:lefrig_dev@localhost:5433/lefrig?schema=public"

# Server
API_PORT=3001
API_PUBLIC_URL="http://localhost:3001"
NODE_ENV=development

# CORS — orígenes permitidos (coma-separados). Vacío o * = todos (solo dev)
# CORS_ORIGINS=http://localhost:3000

# Swagger /docs
ENABLE_SWAGGER=true

# Clerk
CLERK_SECRET_KEY=sk_test_xxxxxxxx
CLERK_WEBHOOK_SECRET=whsec_xxxxxxxx

# JWT legacy (dev)
JWT_SECRET="change-me-in-production-use-long-random-string-lefrig-dev"
JWT_REFRESH_SECRET="change-me-refresh-in-production-use-long-random-string"
AUTH_LEGACY_JWT=true

# Redis / Meilisearch (opcional)
REDIS_URL="redis://localhost:6379"
MEILISEARCH_HOST="http://localhost:7700"
MEILISEARCH_API_KEY="lefrig_meili_dev_key"

# Storage — local dev (S3/R2 en prod: ver .env.production.example)
UPLOAD_DIR=uploads
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_BUCKET="lefrig"
STORAGE_ACCESS_KEY="lefrig"
STORAGE_SECRET_KEY="lefrig_dev"
STORAGE_PUBLIC_URL="http://localhost:9000/lefrig"
