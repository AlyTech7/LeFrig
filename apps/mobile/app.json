{
  "expo": {
    "name": "Lefrig",
    "slug": "lefrig",
    "owner": "alytech7",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "lefrig",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0B10"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lefrig.app",
      "buildNumber": "1",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSFaceIDUsageDescription": "Lefrig usa Face ID para que entres de forma rápida y segura.",
        "NSCameraUsageDescription": "Lefrig usa la cámara para fotos de anuncios, tiendas y tu perfil.",
        "NSPhotoLibraryUsageDescription": "Lefrig accede a tus fotos para publicar anuncios y actualizar tu perfil.",
        "NSPhotoLibraryAddUsageDescription": "Lefrig puede guardar imágenes compartidas en tu galería.",
        "CFBundleAllowMixedLocalizations": true
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": ["C617.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": ["E174.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": ["35F9.1"]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0B10"
      },
      "package": "com.lefrig.app",
      "versionCode": 4,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.INTERNET",
        "android.permission.VIBRATE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Lefrig usa Face ID para que entres de forma rápida y segura."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Lefrig accede a tus fotos para publicar anuncios y actualizar tu perfil.",
          "cameraPermission": "Lefrig usa la cámara para fotos de anuncios, tiendas y tu perfil.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0A0B10"
        }
      ],
      "expo-font",
      [
        "expo-updates",
        {
          "username": "alytech7"
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/868fa9b8-5f2f-4862-9e34-e378cc5f186e",
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD"
    },
    "experiments": {
      "typedRoutes": true,
      "autolinkingModuleResolution": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "868fa9b8-5f2f-4862-9e34-e378cc5f186e"
      },
      "privacyPolicyUrl": "https://www.lefrig.com/legal#privacidad",
      "termsUrl": "https://www.lefrig.com/legal#terminos",
      "accountDeletionUrl": "https://www.lefrig.com/account-deletion"
    }
  }
}
