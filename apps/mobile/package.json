{
  "name": "@lefrig/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "cross-env EXPO_OFFLINE=1 NODE_OPTIONS=--max-old-space-size=8192 expo start --port 8082 --host lan",
    "dev:clear": "cross-env EXPO_OFFLINE=1 NODE_OPTIONS=--max-old-space-size=8192 expo start --port 8082 --host lan --clear",
    "start": "cross-env EXPO_OFFLINE=1 NODE_OPTIONS=--max-old-space-size=8192 expo start --port 8082 --host lan",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint . --max-warnings 9999 && tsc --noEmit",
    "clean": "rimraf .expo node_modules/.cache",
    "eas-build-post-install": "pnpm --filter @lefrig/shared build"
  },
  "dependencies": {
    "@clerk/clerk-expo": "^2.19.36",
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "^15.0.2",
    "@lefrig/shared": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.26",
    "expo-apple-authentication": "^57.0.2",
    "expo-auth-session": "~57.0.13",
    "expo-blur": "~57.0.3",
    "expo-clipboard": "^57.0.2",
    "expo-constants": "~57.0.20",
    "expo-crypto": "~57.0.3",
    "expo-device": "^57.0.2",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "^57.0.20",
    "expo-image-picker": "^57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-local-authentication": "~57.0.3",
    "expo-notifications": "^57.0.21",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "^57.0.22",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "^57.0.24",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "~4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@expo/ngrok": "^4.1.0",
    "@lefrig/config": "workspace:*",
    "@types/react": "~19.2.18",
    "cross-env": "^10.1.0",
    "rimraf": "^6.0.1",
    "typescript": "^6.0.3"
  }
}
