{
  "name": "@lefrig/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "cross-env EXPO_OFFLINE=1 NODE_OPTIONS=--max-old-space-size=8192 expo start --port 8082 --host lan",
    "dev:clear": "cross-env EXPO_OFFLINE=1 NODE_OPTIONS=--max-old-space-size=8192 expo start --port 8082 --host lan --clear",
    "start": "cross-env EXPO_OFFLINE=1 NODE_OPTIONS=--max-old-space-size=8192 expo start --port 8082 --host lan",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "clean": "rimraf .expo node_modules/.cache"
  },
  "dependencies": {
    "@clerk/clerk-expo": "^2.9.0",
    "@expo/metro-runtime": "~6.1.2",
    "@lefrig/shared": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~54.0.0",
    "expo-auth-session": "~7.0.11",
    "expo-clipboard": "^57.0.0",
    "expo-constants": "~18.0.0",
    "expo-crypto": "~15.0.9",
    "expo-device": "^56.0.4",
    "expo-image-manipulator": "^57.0.2",
    "expo-image-picker": "^57.0.2",
    "expo-linear-gradient": "~15.0.0",
    "expo-linking": "~8.0.0",
    "expo-notifications": "^56.0.18",
    "expo-router": "~6.0.0",
    "expo-secure-store": "~15.0.0",
    "expo-sharing": "^57.0.3",
    "expo-status-bar": "~3.0.0",
    "expo-web-browser": "~15.0.11",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@lefrig/config": "workspace:*",
    "@types/react": "~19.1.0",
    "cross-env": "^10.1.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.2"
  }
}
