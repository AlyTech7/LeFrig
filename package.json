{
  "name": "lefrig",
  "version": "0.1.0",
  "private": true,
  "description": "Lefrig — Superapp saharaui: marketplace, efectivo, transporte, diáspora y comunidad",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @lefrig/e2e test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:migrate": "pnpm --filter @lefrig/api db:migrate",
    "db:seed": "pnpm --filter @lefrig/api db:seed",
    "db:studio": "pnpm --filter @lefrig/api db:studio",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:prod": "docker compose -f docker-compose.prod.yml up --build -d",
    "docker:prod:down": "docker compose -f docker-compose.prod.yml down",
    "clean": "turbo run clean && rimraf node_modules"
  },
  "devDependencies": {
    "@lefrig/config": "workspace:*",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "@clerk/backend>react": "19.1.0",
      "@clerk/backend>react-dom": "19.1.0",
      "next": "15.5.22",
      "vitest": "^3.2.6",
      "@nestjs/core": "^11.1.18",
      "@clerk/clerk-expo": "^2.19.36",
      "@clerk/clerk-react": "^5.61.6",
      "ajv@8": ">=8.18.0",
      "body-parser": ">=1.20.6",
      "brace-expansion@1": "1.1.18",
      "brace-expansion@2": "2.1.4",
      "brace-expansion@5": "5.0.9",
      "esbuild": ">=0.25.0",
      "fast-uri": ">=3.1.4",
      "file-type": ">=21.3.2",
      "glob": ">=10.5.0",
      "js-yaml@3": "3.15.1",
      "js-yaml@4": "4.3.1",
      "js-yaml@5": "5.2.2",
      "lodash": ">=4.17.23",
      "multer": ">=2.2.0",
      "nanoid@3": "3.3.18",
      "nanoid@5": "5.1.16",
      "deepmerge-ts": "8.0.0",
      "picomatch": ">=2.3.1",
      "postcss": "8.5.25",
      "qs": ">=6.15.2",
      "sharp": ">=0.35.0",
      "tar": ">=7.5.21",
      "tmp": ">=0.2.4",
      "uuid": "11.1.1",
      "vite": ">=6.4.3",
      "webpack": ">=5.104.1",
      "ws@8": "8.21.1"
    }
  }
}
