# ─── LeFrig — Plantilla producción ─────────────────────────────────────────
# Copia a .env en cada servicio o configura en Vercel / Railway / Fly.io

# ═══ Vercel (apps/web) ═══════════════════════════════════════════════════════
NEXT_PUBLIC_API_URL=https://api.tudominio.com
NEXT_PUBLIC_APP_NAME=Lefrig

# Clerk LIVE (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_xxxxxxxx
CLERK_SECRET_KEY=sk_live_xxxxxxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/marketplace
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/marketplace

# No usar datos demo en prod (omitir o dejar en false)
# NEXT_PUBLIC_ALLOW_DEMO_FALLBACK=false

# ═══ API (Railway / Fly.io / Render / VPS) ═══════════════════════════════════
NODE_ENV=production
API_PORT=3001
API_PUBLIC_URL=https://api.tudominio.com

# Orígenes permitidos CORS (dominio web, separados por coma)
CORS_ORIGINS=https://tudominio.com,https://www.tudominio.com,https://tu-proyecto.vercel.app

# PostgreSQL (Neon, Supabase, RDS — PostGIS recomendado)
DATABASE_URL=postgresql://user:pass@host:5432/lefrig?schema=public

# Clerk (mismas keys que web + webhook)
CLERK_SECRET_KEY=sk_live_xxxxxxxx
CLERK_WEBHOOK_SECRET=whsec_xxxxxxxx

# JWT — desactivar legacy en producción
AUTH_LEGACY_JWT=false
JWT_SECRET=genera-un-secreto-largo-aleatorio-min-32-chars
JWT_REFRESH_SECRET=otro-secreto-largo-aleatorio-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Redis (opcional — caché y rate limit)
REDIS_URL=redis://default:pass@host:6379

# Meilisearch (opcional — búsqueda avanzada)
MEILISEARCH_HOST=https://meili.tudominio.com
MEILISEARCH_API_KEY=genera-master-key-segura

# Storage S3-compatible (Cloudflare R2, AWS S3, MinIO)
STORAGE_ENDPOINT=https://xxxx.r2.cloudflarestorage.com
STORAGE_BUCKET=lefrig
STORAGE_ACCESS_KEY=xxxxxxxx
STORAGE_SECRET_KEY=xxxxxxxx
STORAGE_PUBLIC_URL=https://cdn.tudominio.com

# Uploads locales (solo dev / VPS con volumen persistente)
# UPLOAD_DIR=/data/uploads

# Swagger — desactivar en prod
ENABLE_SWAGGER=false

# Firebase push (opcional)
FCM_PROJECT_ID=
FCM_SERVER_KEY=

# ═══ Mobile (EAS / Expo) ═════════════════════════════════════════════════════
EXPO_PUBLIC_API_URL=https://api.tudominio.com
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_xxxxxxxx

# ═══ Admin (segundo proyecto Vercel, opcional) ═══════════════════════════════
# NEXT_PUBLIC_API_URL=https://api.tudominio.com
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_xxxxxxxx
# CLERK_SECRET_KEY=sk_live_xxxxxxxx
