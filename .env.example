# Database
DATABASE_URL="postgresql://lefrig:lefrig_dev@localhost:5433/lefrig?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Meilisearch
MEILISEARCH_HOST="http://localhost:7700"
MEILISEARCH_API_KEY="lefrig_meili_dev_key"

# ─── Clerk (https://dashboard.clerk.com) ───────────────────────────────────
CLERK_SECRET_KEY=sk_test_xxxxxxxx
CLERK_WEBHOOK_SECRET=whsec_xxxxxxxx
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxx
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxx

# URLs Clerk (web)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/marketplace
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/marketplace

# JWT legacy (dev / seed — fallback si AUTH_LEGACY_JWT=true)
JWT_SECRET="change-me-in-production-use-long-random-string-lefrig-dev"
JWT_REFRESH_SECRET="change-me-refresh-in-production-use-long-random-string"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
AUTH_LEGACY_JWT=true

# OTP mock (deprecated — usar Clerk)
OTP_MOCK_CODE="123456"

# Storage (S3-compatible mock)
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_BUCKET="lefrig"
STORAGE_ACCESS_KEY="lefrig"
STORAGE_SECRET_KEY="lefrig_dev"
STORAGE_PUBLIC_URL="http://localhost:9000/lefrig"

# Firebase (mock in dev)
FCM_PROJECT_ID="lefrig-mock"
FCM_SERVER_KEY="mock-fcm-key"

# API
API_PORT=3001
API_URL="http://localhost:3001"
API_PUBLIC_URL="http://localhost:3001"

# CORS (prod: lista separada por comas; dev: * o vacío = todos)
# CORS_ORIGINS=https://tudominio.com,https://tu-proyecto.vercel.app

# Swagger en API (/docs) — false en producción
ENABLE_SWAGGER=true

# Web & Admin
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_APP_NAME="Lefrig"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Firma cookie sesión admin (prod obligatorio). En non-prod, fallback a CLERK_SECRET_KEY.
ADMIN_SESSION_SECRET="change-me-admin-session-long-random-string"

# Mobile
EXPO_PUBLIC_API_URL="http://localhost:3001"
